# Recruitment SaaS only — never commit real credentials.
# Copy the pooled connection string from Neon Console > Connect.
# Keep this server-only (do not add NEXT_PUBLIC_).
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Branch-specific Managed Neon Auth URL; populated by: neon env pull --service auth
NEON_AUTH_BASE_URL=https://YOUR-BRANCH-ID.neonauth.REGION.aws.neon.tech/neondb/auth

RESEND_API_KEY=replace-with-your-resend-api-key
RESEND_FROM=OptiFlow Recruitment <verified-sender@your-domain.com>\n\n# OAuth provider credentials (add after callback URLs are deployed)\nGOOGLE_CLIENT_ID=\nGOOGLE_CLIENT_SECRET=\nMICROSOFT_CLIENT_ID=\nMICROSOFT_CLIENT_SECRET=\nZOOM_CLIENT_ID=\nZOOM_CLIENT_SECRET=\n\n# Generate with: openssl rand -base64 32 (server-only, used to encrypt provider tokens)\nTOKEN_ENCRYPTION_KEY=

# Generate locally with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=replace-with-a-generated-random-secret
