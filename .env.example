# Recruitment SaaS only — never commit real credentials.
# Copy the pooled connection string from Neon Console > Connect.
# Keep this server-only (do not add NEXT_PUBLIC_).
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Copy the Auth URL from the Neon Auth section for the same branch.
NEXT_PUBLIC_NEON_AUTH_URL=https://YOUR-BRANCH-ID.neonauth.REGION.aws.neon.tech/neondb/auth
