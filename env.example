# Copy to .env.local for local work. In production add the same names in Netlify
# (Site configuration > Environment variables). Never commit real values.
# The site works with none of these set. Each one switches on an extra.

NEXT_PUBLIC_SITE_URL=https://optiflowops.online

# Resend: emails enquiries and payment alerts. Secrets: never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=
RESEND_FROM=
# Optional. Defaults to shedrackebete@optiflowops.online
ENQUIRY_NOTIFY_TO=

# Paystack: package payments. Use the TEST secret key (sk_test_...) first, then the live key.
# Secret: never prefix with NEXT_PUBLIC_ and never commit it.
PAYSTACK_SECRET_KEY=

# Supabase (optional): keeps a copy of each email enquiry. The anon key is public by design.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Leave unset in release 1. Set to true only to bring the admin dashboard back.
ENABLE_ADMIN=
